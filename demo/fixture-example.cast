[0.28, "o", " ships this extension.\r\n  \u001b[2m+ 80\u001b[22m  \u001b[31mhigh  \u001b[39m  activationEvents added \"*\", so the extension activates on every event.\r\n  \u001b[2m+ 70\u001b[22m  \u001b[31mhigh  \u001b[39m  npm lifecycle script added: postinstall (node payload.js). Install scripts run when the package is installed.\r\n  \u001b[2m+ 60\u001b[22m  \u001b[31mhigh  \u001b[39m  native.node: New native binary (.node). Native code runs outside the JavaScript sandbox."]
[0.31, "o", "\r\n  \u001b[2m+ 55\u001b[22m  \u001b[31mhigh  \u001b[39m  extension.js: New eval( call. The extension can execute a string as code.\r\n  \u001b[2m+ 55\u001b[22m  \u001b[31mhigh  \u001b[39m  extension.js: New Function constructor. The extension can compile a string into code.\r\n  \u001b[2m+ 35\u001b[22m  \u001b[33mmedium\u001b[39m  payload.bin: Shannon entropy 7.80 bits/byte on 1024 sampled bytes (threshold 7.5). Random-looking content is unusual outside images"]
[0.34, "o", ", fonts, archives, and wasm.\r\n  \u001b[2m+ 30\u001b[22m  \u001b[33mmedium\u001b[39m  untrustedWorkspaces.supported is now true, so the extension may run in untrusted workspaces.\r\n  \u001b[2m+ 30\u001b[22m  \u001b[33mmedium\u001b[39m  extension.js: New child_process reference. The extension can spawn local processes.\r\n  \u001b[2m+ 25\u001b[22m  \u001b[33mmedium\u001b[39m  extension.js: New raw IP: 203.0.113.10. Hard-coded addresses are a common callback pat"]
